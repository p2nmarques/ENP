menu "ENP - ESP Network Protocol"

choice DEVICE_ROLE

    prompt "Device Role"

    default DEVICE_ROLE_GATEWAY

config DEVICE_ROLE_GATEWAY
    bool "Gateway"
	
config DEVICE_ROLE_RELAY
	    bool "Relay"

config DEVICE_ROLE_SENSOR
    bool "Sensor"

endchoice

config ESP_WIFI_SSID
    string "WiFi SSID"

config ESP_WIFI_PASSWORD
    string "WiFi Password"

config GATEWAY_MAC
    string "Gateway MAC Address"
    default "94:e6:86:0d:11:8c"
	
config ENP_E3_NODE_ID
    int "ENP test node ID"
    range 1 3
    default 1
    help
        Physical node ID used by the three-node tests.
        Use 1 for A/Gateway, 2 for B/Relay, and 3 for C/Sensor.


endmenu