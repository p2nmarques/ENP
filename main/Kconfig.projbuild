menu "ESP-NOW Demo"

choice DEVICE_ROLE

    prompt "Device Role"

    default DEVICE_ROLE_GATEWAY

config DEVICE_ROLE_GATEWAY
    bool "Gateway"

config DEVICE_ROLE_SENSOR
    bool "Sensor"

endchoice

config ESP_WIFI_SSID
    string "WiFi SSID"

config ESP_WIFI_PASSWORD
    string "WiFi Password"

config GATEWAY_MAC
    string "Gateway MAC Address"
    default "24:6F:28:12:34:56"

endmenu